[Unit]
Description=CODE3B token auto-refresh (Dhan rolling renew + Kite expiry alert)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/CODE3B- TV BACKTEST ENGINE
Environment=PYTHONUNBUFFERED=1
# python path me space hai -> quote zaroori (systemd 203/EXEC warna)
ExecStart="/root/CODE3B- TV BACKTEST ENGINE/venv/bin/python" -X utf8 _ops/token_refresh.py
# 3 = "chala, par dhyan do" (Kite token dead — alert nikal chuka hai): success.
# 1 = CRASH: ise failure hi rehne do. Dono ko ek saath success maan lena matlab
# ek mara hua refresher bhi "Finished successfully" dikhega (ye deploy pe hua tha).
SuccessExitStatus=0 3
