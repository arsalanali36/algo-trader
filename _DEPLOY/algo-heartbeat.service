[Unit]
Description=CODE3B dead-man switch (services + dashboard + supervisor events + daily alive-ping)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/CODE3B- TV BACKTEST ENGINE
Environment=PYTHONUNBUFFERED=1
# python path me space hai -> quote zaroori (systemd 203/EXEC warna)
ExecStart="/root/CODE3B- TV BACKTEST ENGINE/venv/bin/python" -X utf8 _ops/heartbeat.py
# 3 = "chala, kuch dikkat mili, alert nikal chuka hai": success.
# 1 = CRASH: failure hi rehne do (TRAP #193).
SuccessExitStatus=0 3
