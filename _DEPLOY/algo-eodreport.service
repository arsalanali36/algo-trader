[Unit]
Description=CODE3B EOD report generator (digest + TRAP#108 replay -> data/reports/)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/CODE3B- TV BACKTEST ENGINE
# python path me space hai -> quote zaroori
ExecStart="/root/CODE3B- TV BACKTEST ENGINE/venv/bin/python" -X utf8 _ops/eod_report.py
# report me RED aana script-failure nahi hai
SuccessExitStatus=0 1
