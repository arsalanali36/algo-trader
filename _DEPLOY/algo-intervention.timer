[Unit]
Description=Run CODE3B intervention report weekday post-close (16:20 IST)

[Timer]
# 15:25 close -> 16:10 equity-daily lake fill (RSI-midline candles) -> 16:20 here.
# (engine also has a live-fetch fallback, so it works even before the lake fills.)
OnCalendar=Mon..Fri 16:20:00
Persistent=false

[Install]
WantedBy=timers.target
