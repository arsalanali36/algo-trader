{
  "success": true,
  "source": "//@version=5\r\nstrategy(\"🦺Ars_Auto_Rev_Chain_😎_common\", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, default_qty_type=strategy.percent_of_equity, default_qty_value=100)\r\n\r\n\r\n// ===== INPUTS =====//\r\n//=== Time Filter Inputs ===\r\ngrp1 = \"Day Selection\"\r\n\r\n// 🔄 CHANGED: Single day → Multi-month date range\r\nstartDate   = input.time(timestamp(\"2026-01-01 09:15\"), title=\"Backtest Start Date\", group=\"Day Selection\")\r\nendDate     = input.time(timestamp(\"2026-12-31 15:15\"), title=\"Backtest End Date\",   group=\"Day Selection\")\r\ninDateRange = (time >= startDate and time <= endDate)\r\n\r\nmaxTradesPerDay = 2\r\n// maxTradesPerDay = input.int(4, \"Max Trades Per Day\", minval=1, group=\"Day Selection\")\r\n\r\n// ===== GROUP ORDER FIX — Exit & Zone Logic ko upar lane ke liye =====\r\n// Pine Script mein jo group pehle declare hoga woh Settings mein upar dikhega\r\n// Isliye yahan pehle declare kar rahe hain — actual logic neeche same jagah hai\r\nMainExit_Toggle     = true\r\nAtrExit_Toggle      = true\r\nSL_Blw_Fib_Exit_Tog = true\r\n\r\n// MainExit_Toggle     = input.bool(true,  \"Zone Exit\", group=\"Exit ⏰\")\r\n// AtrExit_Toggle      = input.bool(true,  \"ATR Exit\",  group=\"Exit ⏰\")\r\n// SL_Blw_Fib_Exit_Tog = input.bool(true,  \"Fib Exit\",  group=\"Exit ⏰\")\r\nmaxCandleSize       = 40\r\n// maxCandleSize       = input.float(25.0, \"Max Candle Size (Points)\", minval=1.0, step=1.0, group=\"Exit ⏰\", tooltip=\"Entry skip hoga agar candle ka size (High-Low) is value se zyada ho. Nifty ke liye 20-40 try karo.\")\r\n\r\n\r\nHawaME_toggle    = false\r\nuseFreshZoneOnly = true\r\n\r\n// HawaME_toggle    = input.bool(false, \"🌬️ Hawa Me Zone\",      group=\"🧠 Zone Logic\")\r\n// useFreshZoneOnly = input.bool(true,  \"✅ Use Fresh Zone Only\", group=\"🧠 Zone Logic\")\r\n// ===== END GROUP ORDER FIX =====\r\n\r\n// 🔄 REMOVED: selected_bars_ago manual logic — ab always 1 (yesterday)\r\n// selected_bars_ago is now hardcoded to 1 (previous day always)\r\n\r\nlookback          = 20\r\nmax_jump_pct_input = 50\r\n// max_jump_pct_input = input.float(50.0, \"Max Chain Jump % (Non-Index)\", minval=1.0, maxval=500.0, step=5.0, group=grp1, tooltip=\"Index (Nifty/BankNifty) pe 10% fixed rahega, baaki instruments pe yeh value use hogi\")\r\n\r\ngrp2 = \"High Chain\"\r\nhigh_color  = color(color.red)\r\n\r\ngrp3 = \"Low Chain\"\r\nlow_color   = color(color.green)\r\n\r\ngrp4 = \"Prev Chain Line Style\"\r\n\r\ngrpX = \"KeyLines\"\r\n\r\nshow_chain_global  = true\r\nshow_high          = true\r\nshow_low           = true\r\n\r\n// show_chain_global  = input.bool(true,  \"Show Chain Lines 🔗\",        group=grpX)\r\n// show_high          = show_chain_global and input.bool(true,  \"  ↳ High Chain (H1/H2..)\", group=grpX, inline=\"chain_toggle\")\r\n// show_low           = show_chain_global and input.bool(true,  \"  ↳ Low Chain  (L1/L2..)\", group=grpX, inline=\"chain_toggle\")\r\nshow_chain_name    = show_high or show_low\r\nline_width    = 1\r\nline_style_in = \"dashed\"\r\n\r\nshow_labels   = false\r\nshow_chain_price = false\r\n\r\ngrp5 = \"Yest H/L/C Lines💸💸\"\r\nshow_hlc        = true\r\n// show_hlc        = input.bool(true,         \"Show PrevDay H/L/C Lines\", group=grpX)\r\n\r\nhlc_high_color  = color.red\r\nhlc_low_color   = color.green\r\nhlc_close_color = color.blue\r\n\r\nhlc_width       = 2\r\nhlc_fontsize    = size.normal\r\n\r\ngrp6 = \"Fibonacci Levels (Selected Day)🔑🔑\"\r\nshow_fib       = false\r\n\r\ngrp_fc = \"Fibonacci Grp 🕯️🕯️\"\r\nshow_fc_fib        = false\r\n// show_fc_fib        = input.bool(true,         \"Show First Candle Fib\",   group=grpX)\r\n\r\nfc_fib_color_1     = color.new(color.purple, 10)\r\nfc_fib_color_236   = color.new(color.orange, 10)\r\nfc_fib_color_5     = color.new(color.black, 30)\r\nfc_fib_color_618   = color.new(color.lime,   10)\r\nfc_fib_color_786   = color.new(color.teal,   10)\r\n\r\nfc_fib_width       = 1\r\nfc_fib_style_in    = \"solid\"\r\nfc_fib_show_label  = false\r\nfc_fib_font        = size.small\r\nfc_fib_length      = 10\r\n\r\ngrp_pd = \"Prev Day Fibonacci 📅📅\"\r\nshow_pd_fib        = false\r\n// show_pd_fib        = input.bool(false,         \"Show Prev Day Fib\",        group=grpX,inline = \"x1\")\r\npd_fib_invert      = false\r\n// pd_fib_invert      = input.bool(false, \"🔄 Invert fib \", group=grpX,inline = \"x1\")\r\n\r\npd_fib_color_1     = color.new(color.blue,   10)\r\npd_fib_color_236   = color.new(color.orange, 10)\r\npd_fib_color_5     = color.new(color.black, 0)\r\npd_fib_width_5     = 2\r\npd_fib_style_5_in  = \"solid\"\r\npd_fib_color_618    = color.new(color.lime, 0)\r\npd_fib_width_618    = 2\r\npd_fib_style_618_in = \"solid\"\r\npd_fib_color_786   = color.new(color.teal,   10)\r\npd_fib_width       = 1\r\npd_fib_style_in    = \"dashed\"\r\npd_fib_show_label  = false\r\npd_fib_font        = size.huge\r\npd_fib_label_pos   = \"Right\"\r\n\r\nshow_fib_1_1   = true\r\nshow_fib_0     = true\r\nshow_fib_236   = true\r\nshow_fib_5     = true\r\nshow_fib_618   = true\r\nshow_fib_786   = true\r\nfib_color_1    = (color.new(color.blue, 20))\r\nfib_color_236  = (color.new(color.orange, 20))\r\nfib_color_5    = (color.new(color.black, 20))\r\nfib_color_618  = (color.new(color.lime, 20))\r\nfib_color_786  = (color.new(color.teal, 20))\r\nfib_width      = 1\r\nfib_style_in   = \"solid\"\r\nfib_show_label = false\r\nfib_font       = size.small\r\n\r\n\r\n// ===== DAILY DATA — tuple fetch =====\r\nget_day(idx) =>\r\n    [h, l, c, t] = request.security(syminfo.tickerid, \"D\",\r\n         [high[idx], low[idx], close[idx], time[idx]],\r\n         lookahead=barmerge.lookahead_on)\r\n    [h, l, c, t]\r\n\r\n[h0,  l0,  c0,  t0]  = get_day(0)\r\n[h1,  l1,  c1,  t1]  = get_day(1)\r\n[h2,  l2,  c2,  t2]  = get_day(2)\r\n[h3,  l3,  c3,  t3]  = get_day(3)\r\n[h4,  l4,  c4,  t4]  = get_day(4)\r\n[h5,  l5,  c5,  t5]  = get_day(5)\r\n[h6,  l6,  c6,  t6]  = get_day(6)\r\n[h7,  l7,  c7,  t7]  = get_day(7)\r\n[h8,  l8,  c8,  t8]  = get_day(8)\r\n[h9,  l9,  c9,  t9]  = get_day(9)\r\n[h10, l10, c10, t10] = get_day(10)\r\n[h11, l11, c11, t11] = get_day(11)\r\n[h12, l12, c12, t12] = get_day(12)\r\n[h13, l13, c13, t13] = get_day(13)\r\n[h14, l14, c14, t14] = get_day(14)\r\n[h15, l15, c15, t15] = get_day(15)\r\n[h16, l16, c16, t16] = get_day(16)\r\n[h17, l17, c17, t17] = get_day(17)\r\n[h18, l18, c18, t18] = get_day(18)\r\n[h19, l19, c19, t19] = get_day(19)\r\n[h20, l20, c20, t20] = get_day(20)\r\n\r\n// ===== STORE IN ARRAYS =====\r\nvar float[] dh = array.new_float(21)\r\nvar float[] dl = array.new_float(21)\r\nvar float[] dc = array.new_float(21)\r\nvar int[]   dt = array.new_int(21)\r\n\r\narray.set(dh, 0,  h0)\r\narray.set(dh, 1,  h1)\r\narray.set(dh, 2,  h2)\r\narray.set(dh, 3,  h3)\r\narray.set(dh, 4,  h4)\r\narray.set(dh, 5,  h5)\r\narray.set(dh, 6,  h6)\r\narray.set(dh, 7,  h7)\r\narray.set(dh, 8,  h8)\r\narray.set(dh, 9,  h9)\r\narray.set(dh, 10, h10)\r\narray.set(dh, 11, h11)\r\narray.set(dh, 12, h12)\r\narray.set(dh, 13, h13)\r\narray.set(dh, 14, h14)\r\narray.set(dh, 15, h15)\r\narray.set(dh, 16, h16)\r\narray.set(dh, 17, h17)\r\narray.set(dh, 18, h18)\r\narray.set(dh, 19, h19)\r\narray.set(dh, 20, h20)\r\n\r\narray.set(dl, 0,  l0)\r\narray.set(dl, 1,  l1)\r\narray.set(dl, 2,  l2)\r\narray.set(dl, 3,  l3)\r\narray.set(dl, 4,  l4)\r\narray.set(dl, 5,  l5)\r\narray.set(dl, 6,  l6)\r\narray.set(dl, 7,  l7)\r\narray.set(dl, 8,  l8)\r\narray.set(dl, 9,  l9)\r\narray.set(dl, 10, l10)\r\narray.set(dl, 11, l11)\r\narray.set(dl, 12, l12)\r\narray.set(dl, 13, l13)\r\narray.set(dl, 14, l14)\r\narray.set(dl, 15, l15)\r\narray.set(dl, 16, l16)\r\narray.set(dl, 17, l17)\r\narray.set(dl, 18, l18)\r\narray.set(dl, 19, l19)\r\narray.set(dl, 20, l20)\r\n\r\narray.set(dc, 0,  c0)\r\narray.set(dc, 1,  c1)\r\narray.set(dc, 2,  c2)\r\narray.set(dc, 3,  c3)\r\narray.set(dc, 4,  c4)\r\narray.set(dc, 5,  c5)\r\narray.set(dc, 6,  c6)\r\narray.set(dc, 7,  c7)\r\narray.set(dc, 8,  c8)\r\narray.set(dc, 9,  c9)\r\narray.set(dc, 10, c10)\r\narray.set(dc, 11, c11)\r\narray.set(dc, 12, c12)\r\narray.set(dc, 13, c13)\r\narray.set(dc, 14, c14)\r\narray.set(dc, 15, c15)\r\narray.set(dc, 16, c16)\r\narray.set(dc, 17, c17)\r\narray.set(dc, 18, c18)\r\narray.set(dc, 19, c19)\r\narray.set(dc, 20, c20)\r\n\r\narray.set(dt, 0,  t0)\r\narray.set(dt, 1,  t1)\r\narray.set(dt, 2,  t2)\r\narray.set(dt, 3,  t3)\r\narray.set(dt, 4,  t4)\r\narray.set(dt, 5,  t5)\r\narray.set(dt, 6,  t6)\r\narray.set(dt, 7,  t7)\r\narray.set(dt, 8,  t8)\r\narray.set(dt, 9,  t9)\r\narray.set(dt, 10, t10)\r\narray.set(dt, 11, t11)\r\narray.set(dt, 12, t12)\r\narray.set(dt, 13, t13)\r\narray.set(dt, 14, t14)\r\narray.set(dt, 15, t15)\r\narray.set(dt, 16, t16)\r\narray.set(dt, 17, t17)\r\narray.set(dt, 18, t18)\r\narray.set(dt, 19, t19)\r\narray.set(dt, 20, t20)\r\n\r\n// 🔄 CHANGED: selected_bars_ago always = 1 (yesterday)\r\n// Har bar ka \"selected day\" = previous daily candle\r\nselected_bars_ago = 1\r\n\r\n// ===== FIB ARRAYS =====\r\nvar line[]  fib_lines  = array.new_line()\r\nvar label[] fib_labels = array.new_label()\r\n\r\nf_fib_style() =>\r\n    st = line.style_solid\r\n    if fib_style_in == \"dashed\"\r\n        st := line.style_dashed\r\n    if fib_style_in == \"dotted\"\r\n        st := line.style_dotted\r\n    st\r\n\r\nget_vis(base_color, base_width, level_price) =>\r\n    [base_color, base_width]\r\n\r\ndraw_fib(y_val, clr, lbl_text, start_time) =>\r\n    [fin_clr, fin_wid] = get_vis(clr, fib_width, y_val)\r\n    ln = line.new(\r\n         x1 = start_time, y1 = y_val,\r\n         x2 = start_time + 1, y2 = y_val,\r\n         color = fin_clr, width = fin_wid,\r\n         style = f_fib_style(),\r\n         extend = extend.right,\r\n         xloc = xloc.bar_time)\r\n    array.push(fib_lines, ln)\r\n    if fib_show_label\r\n        lb = label.new(\r\n             x = bar_index, y = y_val,\r\n             text = lbl_text,\r\n             color = color.new(color.white, 100),\r\n             textcolor = fin_clr,\r\n             style = label.style_none,\r\n             size = fib_font)\r\n        array.push(fib_labels, lb)\r\n\r\n// ===== HELPERS =====\r\nf_style() =>\r\n    st = line.style_solid\r\n    if line_style_in == \"dashed\"\r\n        st := line.style_dashed\r\n    if line_style_in == \"dotted\"\r\n        st := line.style_dotted\r\n    st\r\n\r\nf_pd_fib_style() =>\r\n    st = line.style_solid\r\n    if pd_fib_style_in == \"dashed\"\r\n        st := line.style_dashed\r\n    if pd_fib_style_in == \"dotted\"\r\n        st := line.style_dotted\r\n    st\r\n\r\nf_pd_fib_style_50() =>\r\n    st = line.style_solid\r\n    if pd_fib_style_5_in == \"dashed\"\r\n        st := line.style_dashed\r\n    if pd_fib_style_5_in == \"dotted\"\r\n        st := line.style_dotted\r\n    st\r\n\r\nf_pd_fib_style_618() =>\r\n    st = line.style_solid\r\n    if pd_fib_style_618_in == \"dashed\"\r\n        st := line.style_dashed\r\n    if pd_fib_style_618_in == \"dotted\"\r\n        st := line.style_dotted\r\n    st\r\n\r\ndraw_pd_fib(y_val, clr, lbl_text, start_t, lines, labels) =>\r\n    _is50    = lbl_text == \"Prev 50\"\r\n    _is618   = lbl_text == \"Prev 618\"\r\n    _width   = _is50  ? pd_fib_width_5   : _is618 ? pd_fib_width_618  : pd_fib_width\r\n    _style   = _is50  ? f_pd_fib_style_50()        : _is618 ? f_pd_fib_style_618()       : f_pd_fib_style()\r\n    ln = line.new(\r\n         x1 = start_t, y1 = y_val,\r\n         x2 = start_t + 1, y2 = y_val,\r\n         color = clr, width = _width,\r\n         style = _style,\r\n         extend = extend.right,\r\n         xloc = xloc.bar_time)\r\n    array.push(lines, ln)\r\n    if pd_fib_show_label or _is50 or _is618\r\n        pd_lbl_x     = pd_fib_label_pos == \"Left\"   ? start_t :\r\n                       pd_fib_label_pos == \"Center\"  ? math.round((start_t + time) / 2) :\r\n                       bar_index\r\n        pd_lbl_style = pd_fib_label_pos == \"Left\"   ? label.style_label_right :\r\n                       pd_fib_label_pos == \"Center\"  ? label.style_label_center :\r\n                       label.style_label_left\r\n        pd_lbl_xloc  = pd_fib_label_pos == \"Right\"  ? xloc.bar_index : xloc.bar_time\r\n        lb = label.new(\r\n             x = pd_lbl_x, y = y_val,\r\n             text = \"PD \" + lbl_text,\r\n             color = color.new(color.white, 100),\r\n             textcolor = clr,\r\n             style = pd_lbl_style,\r\n             xloc = pd_lbl_xloc,\r\n             size = pd_fib_font)\r\n        array.push(labels, lb)\r\n\r\n// ===== LINE/LABEL ARRAYS =====\r\nvar line[]  all_lines  = array.new_line()\r\nvar label[] all_labels = array.new_label()\r\n\r\nvar float[] chain_high_vals = array.new_float()\r\nvar float[] chain_low_vals  = array.new_float()\r\n\r\nvar float max_jump_pct = na\r\nmax_jump_pct := syminfo.type == \"index\" ? 10.0 : max_jump_pct_input\r\n\r\n// ===== MAIN — barstate.islast pe visual drawing =====\r\nif barstate.islast or barstate.islastconfirmedhistory\r\n\r\n    for ln in all_lines\r\n        line.delete(ln)\r\n    array.clear(all_lines)\r\n    for lb in all_labels\r\n        label.delete(lb)\r\n    array.clear(all_labels)\r\n\r\n    // 🔄 selected_bars_ago = 1 always (yesterday)\r\n    sel_high  = array.get(dh, 1)\r\n    sel_low   = array.get(dl, 1)\r\n    sel_close = array.get(dc, 1)\r\n    sel_time  = array.get(dt, 1)\r\n\r\n    if show_hlc\r\n        hl = line.new(\r\n             x1 = sel_time, y1 = sel_high,\r\n             x2 = sel_time + 1, y2 = sel_high,\r\n             color = hlc_high_color, width = hlc_width,\r\n             style = line.style_solid, extend = extend.right,\r\n             xloc = xloc.bar_time)\r\n        array.push(all_lines, hl)\r\n\r\n        ll = line.new(\r\n             x1 = sel_time, y1 = sel_low,\r\n             x2 = sel_time + 1, y2 = sel_low,\r\n             color = hlc_low_color, width = hlc_width,\r\n             style = line.style_solid, extend = extend.right,\r\n             xloc = xloc.bar_time)\r\n        array.push(all_lines, ll)\r\n\r\n        cl = line.new(\r\n             x1 = sel_time, y1 = sel_close,\r\n             x2 = sel_time + 1, y2 = sel_close,\r\n             color = hlc_close_color, width = hlc_width,\r\n             style = line.style_solid, extend = extend.right,\r\n             xloc = xloc.bar_time)\r\n        array.push(all_lines, cl)\r\n\r\n        if show_labels\r\n            array.push(all_labels, label.new(\r\n                 x = bar_index, y = sel_high,\r\n                 text = \"H \" + str.tostring(sel_high, \"#.##\"),\r\n                 color = color.new(color.white, 100),\r\n                 textcolor = hlc_high_color,\r\n                 style = label.style_none, size = hlc_fontsize))\r\n            array.push(all_labels, label.new(\r\n                 x = bar_index, y = sel_low,\r\n                 text = \"L \" + str.tostring(sel_low, \"#.##\"),\r\n                 color = color.new(color.white, 100),\r\n                 textcolor = hlc_low_color,\r\n                 style = label.style_none, size = hlc_fontsize))\r\n            array.push(all_labels, label.new(\r\n                 x = bar_index, y = sel_close,\r\n                 text = \"C \" + str.tostring(sel_close, \"#.##\"),\r\n                 color = color.new(color.white, 100),\r\n                 textcolor = hlc_close_color,\r\n                 style = label.style_none, size = hlc_fontsize))\r\n\r\n    // ===== HIGH CHAIN =====\r\n    array.clear(chain_high_vals)\r\n    if show_high\r\n        float h_thresh = sel_high\r\n        int max_i = math.min(1 + lookback, 20)\r\n        int h_count = 1\r\n        for i = 2 to max_i\r\n            ph = array.get(dh, i)\r\n            pt = array.get(dt, i)\r\n            jump_pct = (ph - h_thresh) / h_thresh * 100\r\n            if ph > h_thresh and jump_pct <= max_jump_pct\r\n                [hln_clr, hln_wid] = get_vis(high_color, line_width, ph)\r\n                hln = line.new(\r\n                     x1 = pt, y1 = ph,\r\n                     x2 = pt + 1, y2 = ph,\r\n                     color = hln_clr, width = hln_wid,\r\n                     style = f_style(), extend = extend.right,\r\n                     xloc = xloc.bar_time)\r\n                array.push(all_lines, hln)\r\n                array.push(chain_high_vals, ph)\r\n                if show_labels\r\n                    h_name  = show_chain_name  ? \"H\" + str.tostring(h_count) + \" \" : \"\"\r\n                    h_price = show_chain_price ? str.tostring(ph, \"#.##\") : \"\"\r\n                    hlb = label.new(\r\n                         x = bar_index, y = ph,\r\n                         text = h_name + h_price,\r\n                         color = color.new(color.white, 100),\r\n                         textcolor = hln_clr,\r\n                         style = label.style_none,\r\n                         size = hlc_fontsize)\r\n                    array.push(all_labels, hlb)\r\n                h_thresh := ph\r\n                h_count  := h_count + 1\r\n\r\n    // ===== LOW CHAIN =====\r\n    array.clear(chain_low_vals)\r\n    if show_low\r\n        float l_thresh = sel_low\r\n        int max_i = math.min(1 + lookback, 20)\r\n        int l_count = 1\r\n        for i = 2 to max_i\r\n            pl = array.get(dl, i)\r\n            pt = array.get(dt, i)\r\n            drop_pct = (l_thresh - pl) / l_thresh * 100\r\n            if pl < l_thresh and drop_pct <= max_jump_pct\r\n                [lln_clr, lln_wid] = get_vis(low_color, line_width, pl)\r\n                lln = line.new(\r\n                     x1 = pt, y1 = pl,\r\n                     x2 = pt + 1, y2 = pl,\r\n                     color = lln_clr, width = lln_wid,\r\n                     style = f_style(), extend = extend.right,\r\n                     xloc = xloc.bar_time)\r\n                array.push(all_lines, lln)\r\n                array.push(chain_low_vals, pl)\r\n                if show_labels\r\n                    l_name  = show_chain_name  ? \"L\" + str.tostring(l_count) + \" \" : \"\"\r\n                    l_price = show_chain_price ? str.tostring(pl, \"#.##\") : \"\"\r\n                    llb = label.new(\r\n                         x = bar_index, y = pl,\r\n                         text = l_name + l_price,\r\n                         color = color.new(color.white, 100),\r\n                         textcolor = lln_clr,\r\n                         style = label.style_none,\r\n                         size = hlc_fontsize)\r\n                    array.push(all_labels, llb)\r\n                l_thresh := pl\r\n                l_count  := l_count + 1\r\n\r\n    // ===== FIBONACCI LEVELS =====\r\n    if show_fib\r\n        for ln in fib_lines\r\n            line.delete(ln)\r\n        array.clear(fib_lines)\r\n        for lb in fib_labels\r\n            label.delete(lb)\r\n        array.clear(fib_labels)\r\n\r\n        fib_start = array.get(dt, 0)\r\n        fh  = array.get(dh, 0)\r\n        fl  = array.get(dl, 0)\r\n        rng = fh - fl\r\n\r\n        if show_fib_1_1\r\n            draw_fib(fh,               fib_color_1,   \"1\",     fib_start)\r\n        if show_fib_786\r\n            draw_fib(fl + rng * 0.786, fib_color_786, \"0.786\", fib_start)\r\n        if show_fib_618\r\n            draw_fib(fl + rng * 0.618, fib_color_618, \"0.618\", fib_start)\r\n        if show_fib_5\r\n            draw_fib(fl + rng * 0.5,   fib_color_5,   \"0.5\",   fib_start)\r\n        if show_fib_236\r\n            draw_fib(fl + rng * 0.236, fib_color_236, \"0.236\", fib_start)\r\n        if show_fib_0\r\n            draw_fib(fl,               fib_color_1,   \"0\",     fib_start)\r\n\r\n    // ===== PD FIB LEVELS =====\r\n    if show_pd_fib\r\n        pd_high = array.get(dh, 1)\r\n        pd_low  = array.get(dl, 1)\r\n        pd_time = array.get(dt, 1)\r\n        pd_rng  = pd_high - pd_low\r\n\r\n        if not na(pd_high) and not na(pd_low) and pd_rng > 0\r\n            draw_pd_fib(pd_fib_invert ? pd_high - pd_rng * 0.618    : pd_low + pd_rng * 0.618, pd_fib_color_618, \"Prev 618\", pd_time, all_lines, all_labels)\r\n            draw_pd_fib(pd_fib_invert ? pd_high - pd_rng * 0.5      : pd_low + pd_rng * 0.5,   pd_fib_color_5,   \"Prev 50\",  pd_time, all_lines, all_labels)\r\n            draw_pd_fib(pd_fib_invert ? pd_high                     : pd_low,               pd_fib_color_1,   \"0\",        pd_time, all_lines, all_labels)\r\n\r\n\r\n//────────────────────────────────────────────────────────────────────\r\n// Dynamic Pivot Point\r\n//────────────────────────────────────────────────────────────────────\r\n\r\nshowExtra_PP              = true\r\nlineWidthOpt_Yest_OHLC       = 1\r\nstyleMap_Yest_OHLC           = line.style_dashed\r\n\r\nOHLC_line_OpacityPercent = 5.0\r\nOHLC_lineOpacity         = math.round(OHLC_line_OpacityPercent / 100 * 255)\r\npivotColor              = color.new(color.blue,   OHLC_lineOpacity)\r\nresistanceColor         = color.new(color.red,   OHLC_lineOpacity)\r\nsupportColor            = color.new(color.green,   OHLC_lineOpacity)\r\nmode = 0\r\n\r\nisFirstBarOfDay = (ta.change(time(\"D\")) != 0)\r\nprevBarIndex = bar_index - 1\r\nprevHigh  = request.security(syminfo.tickerid, \"D\", high[mode])\r\nprevLow   = request.security(syminfo.tickerid, \"D\", low[mode])\r\nprevClose = request.security(syminfo.tickerid, \"D\", close[mode])\r\n\r\nlineStyleOpt_PIVOT                  = line.style_dashed\r\nlineWidthOpt_PIVOT         = 1\r\nnumberOfPivotsToDraw                = 1\r\nlookbackCandles                     = 1\r\n\r\nshowP           = true\r\nshowLabelsInput = true\r\nshowPricesInput = false\r\n\r\nshowR1          = true\r\nshowR2          = true\r\nshowR3          = true\r\nshowR4          = true and showExtra_PP\r\nshowR5          = true and showExtra_PP\r\n\r\nshowS1          = true\r\nshowS2          = true\r\nshowS3          = true\r\nshowS4          = true and showExtra_PP\r\nshowS5          = true and showExtra_PP\r\n\r\nPivot_line_OpacityPercent = 5.0\r\nPivor_lineOpacity         = math.round(Pivot_line_OpacityPercent / 100 * 255)\r\n\r\nlabelSizeInput = size.large\r\n\r\nlabelSize = labelSizeInput == \"tiny\"  ? size.tiny  :\r\n             labelSizeInput == \"small\" ? size.small :\r\n             labelSizeInput == \"normal\"? size.normal:\r\n             labelSizeInput == \"large\" ? size.large :\r\n             labelSizeInput == \"huge\"  ? size.huge  : size.auto\r\n\r\nenablePivotLines       = true\r\n// enablePivotLines       = input.bool(true, title=\"Pivot Lines\",group = grpX)\r\nPIVOT_INLINE_PP        = \"PP\"\r\nPIVOT_INLINE_R         = \"R\"\r\nPIVOT_INLINE_S         = \"S\"\r\n\r\npivotTypeInput         = \"Traditional\"\r\npivotTimeframe         = \"1D\"\r\npositionLabelsInput    = \"Left\"\r\n\r\ntype GraphicSettings\r\n    string levelName\r\n    color levelColor\r\n    bool showLevel\r\n\r\ntype PivotGraphic\r\n    line pivotLine\r\n    label pivotLabel\r\n\r\nmethod delete(PivotGraphic graphic) =>\r\n    graphic.pivotLine.delete()\r\n    graphic.pivotLabel.delete()\r\n\r\ninitGraphicSettings() =>\r\n     array.from(\r\n         GraphicSettings.new(\"P\",  pivotColor,       showP),\r\n         GraphicSettings.new(\"R1\", resistanceColor,  showR1),\r\n         GraphicSettings.new(\"S1\", supportColor,     showS1),\r\n         GraphicSettings.new(\"R2\", resistanceColor,  showR2),\r\n         GraphicSettings.new(\"S2\", supportColor,     showS2),\r\n         GraphicSettings.new(\"R3\", resistanceColor,  showR3),\r\n         GraphicSettings.new(\"S3\", supportColor,     showS3),\r\n         GraphicSettings.new(\"R4\", resistanceColor,  showR4),\r\n         GraphicSettings.new(\"S4\", supportColor,     showS4),\r\n         GraphicSettings.new(\"R5\", resistanceColor,  showR5),\r\n         GraphicSettings.new(\"S5\", supportColor,     showS5)\r\n     )\r\n\r\naffixOldPivots(matrix<PivotGraphic> drawnGraphics, string labelPosition, int endTime) =>\r\n    if drawnGraphics.rows() > 0\r\n        lastGraphics = drawnGraphics.row(drawnGraphics.rows() - 1)\r\n        for graphic in lastGraphics\r\n            graphic.pivotLine.set_x2(endTime)\r\n            if labelPosition == \"Right\"\r\n                graphic.pivotLabel.set_x(endTime)\r\n\r\ndrawPivotLevels(array<float> pivotPointsArray, array<GraphicSettings> graphicSettingsArray, matrix<PivotGraphic> drawnGraphics, int startTime, int yearMultiplier) =>\r\n    newGraphics = array.new<PivotGraphic>()\r\n    for [index, coord] in pivotPointsArray\r\n        levelSettings = graphicSettingsArray.get(index)\r\n        if not na(coord) and levelSettings.showLevel\r\n            lineEndTime = startTime + timeframe.in_seconds(pivotTimeframe) * 1000 * yearMultiplier\r\n            pivotLine = line.new(startTime, coord, lineEndTime, coord, xloc = xloc.bar_time, color=levelSettings.levelColor, width=lineWidthOpt_PIVOT,style = lineStyleOpt_PIVOT)\r\n            pivotLabel = label.new(\r\n                 x = positionLabelsInput == \"Left\" ? startTime : lineEndTime,\r\n                 y = coord,\r\n                 text = (showLabelsInput ? levelSettings.levelName + \" \" : \"\") + (showPricesInput ? \"(\" + str.tostring(coord, format.mintick) + \")\" : \"\"),\r\n                 style = positionLabelsInput == \"Left\" ? label.style_label_right : label.style_label_left,\r\n                 textcolor = levelSettings.levelColor,\r\n                 color = #00000000,\r\n                 xloc = xloc.bar_time,\r\n                 size = labelSize)\r\n            newGraphics.push(PivotGraphic.new(pivotLine, pivotLabel))\r\n    drawnGraphics.add_row(array_id = newGraphics)\r\n    if drawnGraphics.rows() > numberOfPivotsToDraw\r\n        oldGraphics = drawnGraphics.remove_row(0)\r\n        for graphic in oldGraphics\r\n            graphic.delete()\r\n\r\nvar graphicSettingsArray = initGraphicSettings()\r\nvar drawnGraphics        = matrix.new<PivotGraphic>()\r\npivotYearMultiplier      = 1\r\n\r\npivotTimeframeChangeCounter(condition) =>\r\n    var count = 0\r\n    if condition and bar_index > 0\r\n        count += 1\r\n    count\r\n\r\nlocalTimeframeChange    = timeframe.change(pivotTimeframe)\r\nsecurityTimeframeChange = timeframe.change(timeframe.period)\r\n\r\nlocalPivots      = ta.pivot_point_levels(pivotTypeInput, localTimeframeChange)\r\nsecurityPivotsArray = ta.pivot_point_levels(pivotTypeInput, securityTimeframeChange)\r\n\r\n[securityPivots, pivotDrawTrigger] = request.security(syminfo.tickerid, pivotTimeframe, [securityPivotsArray, pivotTimeframeChangeCounter(securityTimeframeChange)],\r\n lookahead = barmerge.lookahead_on)\r\n\r\npivotP  = array.get(securityPivots, 0)\r\npivotR1 = array.get(securityPivots, 1)\r\npivotS1 = array.get(securityPivots, 2)\r\npivotR2 = array.get(securityPivots, 3)\r\npivotS2 = array.get(securityPivots, 4)\r\npivotR3 = array.get(securityPivots, 5)\r\npivotS3 = array.get(securityPivots, 6)\r\npivotS4 = array.get(securityPivots, 7)\r\npivotR4 = array.get(securityPivots, 8)\r\npivotS5 = array.get(securityPivots, 9)\r\npivotR5 = array.get(securityPivots, 10)\r\n\r\nif enablePivotLines and inDateRange and isFirstBarOfDay\r\n    if pivotDrawTrigger != pivotDrawTrigger[1]\r\n        affixOldPivots(drawnGraphics, positionLabelsInput, time)\r\n        drawPivotLevels(securityPivots, graphicSettingsArray, drawnGraphics, time, pivotYearMultiplier)\r\n\r\n    var FIRST_BAR_TIME = time\r\n    if inDateRange and barstate.islastconfirmedhistory and drawnGraphics.columns() == 0\r\n        if not na(securityPivots) and pivotDrawTrigger > 0\r\n            drawPivotLevels(securityPivots, graphicSettingsArray, drawnGraphics, FIRST_BAR_TIME, pivotYearMultiplier)\r\n        else\r\n            runtime.error(\"Not enough data to calculate Pivot Points. Lower the Pivot Timeframe in the settings.\")\r\n\r\n\r\n//────────────────────────────────────────────────────────────\r\n// 🟢 COLLECT ALL PIVOT + OHLC LEVELS\r\n//────────────────────────────────────────────────────────────\r\n\r\nToggle_Use_lookaheadBars = false\r\nlookaheadBars = 10\r\nincludePIVOT = true\r\nincludeOHLC = true\r\nuseExtraLevels = false\r\nExtra    = 55510\r\n\r\n// 🔄 FIX: float array → typed LevelInfo[] array\r\n// WAJAH: Pehle classification index-position pe based thi (i <= 4, i == 11, etc).\r\n// Jab koi toggle (includePIVOT/includeOHLC/useExtraLevels) on/off hota tha,\r\n// array ka SIZE badal jata tha → sab indices shift ho jate the →\r\n// same price level \"RESISTANCE\" se \"SUPPORT\" ban jata tha sirf position badalne se.\r\n// Ab har level apna type KHUD carry karta hai — value ke saath bandha hua,\r\n// array mein uska position kuch bhi ho, type kabhi nahi badlega.\r\ntype LevelInfo\r\n    float  price\r\n    string ltype   // \"RESISTANCE\",\"SUPPORT\",\"PD_H\",\"PD_L\",\"CP\",\"PD_C\"\r\n\r\nvar LevelInfo[] selectedLines = array.new<LevelInfo>()\r\narray.clear(selectedLines)\r\n\r\nif includePIVOT\r\n    array.push(selectedLines, LevelInfo.new(pivotR5, \"RESISTANCE\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotR4, \"RESISTANCE\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotR3, \"RESISTANCE\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotR2, \"RESISTANCE\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotR1, \"RESISTANCE\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotP,  \"CP\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotS1, \"SUPPORT\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotS2, \"SUPPORT\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotS3, \"SUPPORT\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotS4, \"SUPPORT\"))\r\n    array.push(selectedLines, LevelInfo.new(pivotS5, \"SUPPORT\"))\r\n\r\nif includeOHLC\r\n    array.push(selectedLines, LevelInfo.new(prevHigh,  \"PD_H\"))\r\n    array.push(selectedLines, LevelInfo.new(prevClose, \"PD_C\"))\r\n    array.push(selectedLines, LevelInfo.new(prevLow,   \"PD_L\"))\r\n\r\nif useExtraLevels\r\n    array.push(selectedLines, LevelInfo.new(Extra, \"RESISTANCE\"))\r\n\r\n// 🔄 CHANGED: selected_bars_ago = 1 (always yesterday)\r\n// Chain High levels → type \"RESISTANCE\", Chain Low levels → type \"SUPPORT\"\r\n// (pehle yeh sirf _baseCount/_chainHighEnd index-range se inferred hota tha)\r\nif true\r\n    _ch_thresh = array.get(dh, 1)\r\n    _ch_max_i  = math.min(1 + lookback, 20)\r\n    for _ci = 2 to _ch_max_i\r\n        _cph = array.get(dh, _ci)\r\n        if not na(_cph) and _cph > _ch_thresh\r\n            _jump = (_cph - _ch_thresh) / _ch_thresh * 100\r\n            if _jump <= max_jump_pct\r\n                array.push(selectedLines, LevelInfo.new(_cph, \"RESISTANCE\"))\r\n                _ch_thresh := _cph\r\n    _cl_thresh = array.get(dl, 1)\r\n    for _ci = 2 to _ch_max_i\r\n        _cpl = array.get(dl, _ci)\r\n        if not na(_cpl) and _cpl < _cl_thresh\r\n            _drop = (_cl_thresh - _cpl) / _cl_thresh * 100\r\n            if _drop <= max_jump_pct\r\n                array.push(selectedLines, LevelInfo.new(_cpl, \"SUPPORT\"))\r\n                _cl_thresh := _cpl\r\n\r\nhline(\r\n     useExtraLevels ? Extra : na,\r\n     \"EXTRA Line\",\r\n     color=color.black,\r\n     linestyle=hline.style_solid,\r\n     linewidth=3\r\n     )\r\n\r\n//────────────────────────────────────────────────────────────\r\n// 🕯️ FIRST CANDLE FIBONACCI\r\n//────────────────────────────────────────────────────────────\r\n\r\nvar float fc_high = na\r\nvar float fc_low  = na\r\nvar int   fc_time = na\r\n\r\nif isFirstBarOfDay and inDateRange\r\n    fc_high := high\r\n    fc_low  := low\r\n    fc_time := time\r\n\r\nf_fc_fib_style() =>\r\n    st = line.style_solid\r\n    if fc_fib_style_in == \"dashed\"\r\n        st := line.style_dashed\r\n    if fc_fib_style_in == \"dotted\"\r\n        st := line.style_dotted\r\n    st\r\n\r\nvar line[]  fc_fib_lines  = array.new_line()\r\nvar label[] fc_fib_labels = array.new_label()\r\n\r\ndraw_fc_fib(y_val, clr, lbl_text, start_t, end_t) =>\r\n    ln = line.new(\r\n         x1 = start_t, y1 = y_val,\r\n         x2 = end_t, y2 = y_val,\r\n         color = clr, width = fc_fib_width,\r\n         style = f_fc_fib_style(),\r\n         extend = extend.none,\r\n         xloc = xloc.bar_time)\r\n    array.push(fc_fib_lines, ln)\r\n    if fc_fib_show_label\r\n        lb = label.new(\r\n             x = bar_index, y = y_val,\r\n             text = \"FC \" + lbl_text,\r\n             color = color.new(color.white, 100),\r\n             textcolor = clr,\r\n             style = label.style_none,\r\n             size = fc_fib_font)\r\n        array.push(fc_fib_labels, lb)\r\n\r\nif (barstate.islast or barstate.islastconfirmedhistory) and show_fc_fib and not na(fc_high) and not na(fc_low) and not na(fc_time)\r\n    for ln in fc_fib_lines\r\n        line.delete(ln)\r\n    array.clear(fc_fib_lines)\r\n    for lb in fc_fib_labels\r\n        label.delete(lb)\r\n    array.clear(fc_fib_labels)\r\n\r\n    fc_rng = fc_high - fc_low\r\n\r\n    if fc_rng > 0\r\n        fc_tf_ms  = timeframe.in_seconds() * 1000\r\n        fc_end_t  = fc_time + fc_fib_length * fc_tf_ms\r\n        draw_fc_fib(fc_high,                 fc_fib_color_1,   \"1\",     fc_time, fc_end_t)\r\n        draw_fc_fib(fc_low + fc_rng * 0.786, fc_fib_color_786, \"0.786\", fc_time, fc_end_t)\r\n        draw_fc_fib(fc_low + fc_rng * 0.618, fc_fib_color_618, \"0.618\", fc_time, fc_end_t)\r\n        draw_fc_fib(fc_low + fc_rng * 0.5,   fc_fib_color_5,   \"0.5\",   fc_time, fc_end_t)\r\n        draw_fc_fib(fc_low + fc_rng * 0.236, fc_fib_color_236, \"0.236\", fc_time, fc_end_t)\r\n        draw_fc_fib(fc_low,                  fc_fib_color_1,   \"0\",     fc_time, fc_end_t)\r\n\r\n\r\n//────────────────────────────────────────────────────────────────────\r\n// 🟢🟢🟢🟢 === CANDLE PATTERNS BLOCK ===\r\n//────────────────────────────────────────────────────────────────────\r\n\r\nimport arsalanali36/AA_CandlePatterns/2 as cp\r\nminBodySize     = 0.5\r\nwickRatio       = 2.5\r\nprevBodyMinPts  = 0.5\r\n\r\ngreenHammer = cp.greenHammer(minBodySize, wickRatio)\r\nredHammer   = cp.redHammer(minBodySize, wickRatio)\r\ninvRedHam   = cp.invertedRedHammer(minBodySize, wickRatio)\r\n\r\nbullEngulf = cp.bullishEngulfing(prevBodyMinPts)\r\nbearEngulf = cp.bearishEngulfing(prevBodyMinPts)\r\n\r\nbullHarami = cp.bullishHarami()\r\nbearHarami = cp.bearishHarami()\r\n\r\nplotshape(\r\n     greenHammer and inDateRange,\r\n     title = \"Green Hammer\",\r\n     location = location.belowbar,\r\n     style = shape.labelup,\r\n     color = color.green,\r\n     text = \"🔨\"\r\n     )\r\nplotshape(\r\n     redHammer  and inDateRange,\r\n     title = \"Red Hammer\",\r\n     location = location.belowbar,\r\n     style = shape.labelup,\r\n     color = color.red,\r\n     text = \"🔨\"\r\n     )\r\nplotshape(\r\n     invRedHam  and inDateRange,\r\n     title = \"Inv Red Hammer\",\r\n     location = location.abovebar,\r\n     style = shape.labeldown,\r\n     color = #7f1e1e,\r\n     text = \"🔨ᶦ\"\r\n     )\r\n\r\nbarcolor(\r\n     bullEngulf ? color.black :\r\n     bearEngulf ? color.rgb(2, 0, 0) :\r\n     bullHarami ? color.new(color.green, 70) :\r\n     bearHarami ? color.new(color.red, 70) :\r\n     na\r\n     )\r\n\r\nbullish = (bullEngulf or bullHarami or greenHammer)\r\nprevBullish = (bullEngulf[1] or bullHarami[1] or greenHammer[1])\r\n\r\nbearish = (bearEngulf or bearHarami or invRedHam or redHammer)\r\nprevBearish = (bearEngulf[1] or bearHarami[1] or invRedHam[1] or redHammer[1])\r\n\r\n\r\n// =================================================================\r\n// 🟢🔴 ZONE BUILDING BLOCK\r\n// =================================================================\r\n\r\nshowLatest    = true\r\ndeleteOld     = true\r\nlineLength    = 25\r\n\r\n// HawaME_toggle, useFreshZoneOnly — declared at top for group ordering\r\n\r\nvar float selectedLine = na\r\nvar string lineType    = \"\"\r\n\r\n// 🔄 FIX: _baseCount aur _chainHighEnd (index-math) hata diye gaye.\r\n// Pehle yahan i<=4, i==11, i>=_baseCount etc. se type decide hota tha —\r\n// woh sab toggle-dependent index shifting ka root cause tha.\r\n// Ab seedha lvl.ltype (value ke saath bandha hua) check hota hai.\r\n\r\n// 🔒 Resistance-priority lock: ek baar RESISTANCE/PD_H match ho jaye to\r\n// baad mein loop mein aane wala SUPPORT-type match use overwrite nahi karega.\r\n// Isse R1-R5 / Chain High / PD_H touch hone par Green Zone nahi banega.\r\nvar bool _resistanceLocked = false\r\n_resistanceLocked := false\r\n\r\nfor i = 0 to array.size(selectedLines) - 1\r\n    lvl = array.get(selectedLines, i)\r\n    lineVal = lvl.price\r\n    if not na(lineVal) and (low <= lineVal and high >= lineVal)\r\n        _isResistanceType = (lvl.ltype == \"RESISTANCE\") or (lvl.ltype == \"PD_H\")\r\n        _isSupportType    = (lvl.ltype == \"SUPPORT\")    or (lvl.ltype == \"PD_L\")\r\n\r\n        if _isResistanceType\r\n            selectedLine := lineVal\r\n            lineType := lvl.ltype\r\n            _resistanceLocked := true\r\n        else if _isSupportType and not _resistanceLocked\r\n            selectedLine := lineVal\r\n            lineType := lvl.ltype\r\n        else if not _resistanceLocked\r\n            selectedLine := lineVal\r\n            lineType := lvl.ltype   // \"CP\" or \"PD_C\"\r\n\r\nvar float trackedHigh  = na\r\nvar float trackedLow   = na\r\nvar int trackedHighBar = na\r\nvar int trackedLowBar  = na\r\nvar int touchStartBar  = na\r\nvar bool touchActive   = false\r\nvar line hhLine        = na\r\nvar line llLine        = na\r\nvar color hhColor      = na\r\nvar color llColor      = na\r\nvar float hhPrice      = na\r\nvar float llPrice      = na\r\n\r\ntouched = inDateRange and not na(selectedLine) and (low <= selectedLine and high >= selectedLine)\r\n\r\nif touched and not touchActive\r\n    touchActive    := true\r\n    touchStartBar  := bar_index\r\n    trackedHigh    := high\r\n    trackedLow     := low\r\n    trackedHighBar := bar_index\r\n    trackedLowBar  := bar_index\r\n\r\nhhColor := na\r\nllColor := na\r\nif not na(selectedLine) and showLatest\r\n    if lineType == \"RESISTANCE\" or lineType == \"PD_H\"\r\n        hhColor := color.red\r\n        llColor := color.black\r\n    else if lineType == \"SUPPORT\" or lineType == \"PD_L\"\r\n        hhColor := color.black\r\n        llColor := color.green\r\n    else if lineType == \"CP\" or lineType == \"PD_C\"\r\n        hhColor := color.orange\r\n        llColor := color.orange\r\n\r\nif touchActive\r\n    if inDateRange and not na(selectedLine) and low <= selectedLine and high >= selectedLine\r\n        if high > trackedHigh or na(trackedHigh)\r\n            trackedHigh    := high\r\n            trackedHighBar := bar_index\r\n            hhPrice        := high\r\n        if low < trackedLow or na(trackedLow)\r\n            trackedLow    := low\r\n            trackedLowBar := bar_index\r\n            llPrice       := low\r\n\r\nhhWidth = (hhColor == color.black) ? 2 : 5\r\nllWidth = (llColor == color.black) ? 2 : 5\r\n\r\nvar label hhLabel = na\r\nvar label llLabel = na\r\n\r\nif inDateRange and bar_index == trackedHighBar\r\n    if deleteOld and not na(hhLine)\r\n        line.delete(hhLine)\r\n        if not na(hhLabel)\r\n            label.delete(hhLabel)\r\n    hhLine := line.new(bar_index, trackedHigh, bar_index + lineLength, trackedHigh, color=hhColor, width=hhWidth)\r\n    hhLabel := label.new(bar_index + lineLength, trackedHigh, \"HH\", style=label.style_label_left, color=color.new(color.blue, 80), textcolor=color.black)\r\n\r\nif inDateRange and bar_index == trackedLowBar\r\n    if deleteOld and not na(llLine)\r\n        line.delete(llLine)\r\n        if not na(llLabel)\r\n            label.delete(llLabel)\r\n    llLine := line.new(bar_index, trackedLow, bar_index + lineLength, trackedLow, color=llColor, width=llWidth)\r\n    llLabel := label.new(bar_index + lineLength, trackedLow, \"LL\", style=label.style_label_left, color=color.new(color.blue, 80), textcolor=color.black)\r\n\r\nlatestHH = na(hhLine) ? na : line.get_y1(hhLine)\r\nlatestLL = na(llLine) ? na : line.get_y1(llLine)\r\n\r\ntouchHH = high >= latestHH\r\ntouchLL = low  <= latestLL\r\n\r\nvar bool touchedHH_prev = false\r\nvar bool touchedLL_prev = false\r\n\r\nif touchHH\r\n    touchedHH_prev := true\r\nif touchLL\r\n    touchedLL_prev := true\r\n\r\neffectiveTouchedHH = HawaME_toggle ? touchedHH_prev : false\r\neffectiveTouchedLL = HawaME_toggle ? touchedLL_prev : false\r\n\r\nBearish_Candle_exitingZone = (touched or effectiveTouchedHH) and bearish and (lineType != \"SUPPORT\") and (lineType != \"PD_L\")\r\nBullish_Candle_exitingZone = (touched or effectiveTouchedLL) and bullish and (lineType != \"RESISTANCE\") and (lineType != \"PD_H\")\r\n\r\nvar bool Green_Zone = false\r\nvar bool Red_Zone   = false\r\n\r\nvar bool Green_Zone_Touch_and_Candle = false\r\nvar bool Red_Zone_Touch_and_Candle   = false\r\n\r\n// 🔄 CHANGED: zone_Upper_line/zone_Lower_line (line objects) → zone_Box (box object)\r\n// WAJAH: Pine Script mein line, box, label — teeno ke alag-alag 500 object pools hain.\r\n// Pehle zones LINE objects the, jo Chain/Pivot/Fib lines ke SAME pool mein count hote the.\r\n// Lambe multi-month backtest mein total lines 500 cross kar jati thi, aur Pine Script\r\n// automatically sabse PURANI line delete kar deta tha — kabhi kabhi woh active\r\n// zone-tracking line hoti thi, jiski wajah se naye zones \"random\" jagah ban jate the\r\n// jab Fib toggles on/off karne se history re-run hoti thi.\r\n// Box object ek alag pool use karta hai, isliye Chain/Pivot/Fib lines se compete nahi karega.\r\nvar box   zone_Box       = na\r\nvar label bullZoneLabel  = na\r\n\r\nvar int lastGreenZoneBar = na\r\nvar int lastRedZoneBar   = na\r\nmaxZoneAge = 2\r\n\r\nif Bullish_Candle_exitingZone and inDateRange\r\n    lastGreenZoneBar := bar_index\r\nif Bearish_Candle_exitingZone and inDateRange\r\n    lastRedZoneBar := bar_index\r\n\r\ngreenZoneFresh = not na(lastGreenZoneBar) and (bar_index - lastGreenZoneBar <= maxZoneAge)\r\nredZoneFresh   = not na(lastRedZoneBar)   and (bar_index - lastRedZoneBar   <= maxZoneAge)\r\n\r\n// keepOldLines removed — purani zones ab delete nahi hoti (box object hi hai),\r\n// aur 500-cap cross hone par Pine sirf sabse purani BOX delete karega,\r\n// jo Chain/Pivot/Fib LINE count ko affect nahi karega.\r\n\r\nif (Bearish_Candle_exitingZone or Bullish_Candle_exitingZone) and inDateRange\r\n\r\n    _isBull    = Bearish_Candle_exitingZone\r\n    _color     = _isBull ? color.new(color.red, 0) : color.new(color.teal, 0)\r\n    _highPrice = high\r\n    _lowPrice  = low\r\n\r\n    zone_Box := box.new(\r\n         left = bar_index, top = _highPrice,\r\n         right = bar_index + 10, bottom = _lowPrice,\r\n         border_color = _color, border_width = 2,\r\n         bgcolor = color.new(_color, 90))\r\n\r\n    Green_Zone := Bullish_Candle_exitingZone\r\n    Red_Zone   := Bearish_Candle_exitingZone\r\n\r\n    Green_Zone_Touch_and_Candle := Bullish_Candle_exitingZone\r\n    Red_Zone_Touch_and_Candle   := Bearish_Candle_exitingZone\r\n\r\n    if Bullish_Candle_exitingZone\r\n        log.info(\"ZONE GREEN \" + str.format_time(time,\"yyyy-MM-dd HH:mm\",\"Asia/Kolkata\") + \" hi=\" + str.tostring(high,\"#.##\") + \" lo=\" + str.tostring(low,\"#.##\") + \" line=\" + lineType)\r\n    if Bearish_Candle_exitingZone\r\n        log.info(\"ZONE RED \" + str.format_time(time,\"yyyy-MM-dd HH:mm\",\"Asia/Kolkata\") + \" hi=\" + str.tostring(high,\"#.##\") + \" lo=\" + str.tostring(low,\"#.##\") + \" line=\" + lineType)\r\n\r\n    _distance = math.round(math.abs(_highPrice - _lowPrice))\r\n    _distText = str.tostring(_distance)\r\n    bullZoneLabel := label.new(bar_index + 10, _highPrice, text=_distText, xloc=xloc.bar_index, yloc=yloc.price,\r\n                               style=label.style_label_center, color=_color, textcolor=color.white, size=size.small)\r\n\r\n    touchedHH_prev := false\r\n    touchedLL_prev := false\r\n\r\n// 🔄 CHANGED: zone_Lower_line_price/zone_Upper_line_price ab box.get_bottom()/box.get_top() se aate hain\r\nvar float zone_Lower_line_price = na\r\nvar float zone_Upper_line_price = na\r\n\r\nif not na(zone_Box)\r\n    zone_Lower_line_price := box.get_bottom(zone_Box)\r\n    zone_Upper_line_price := box.get_top(zone_Box)\r\n\r\n\r\n// =================================================================\r\n// 🛡️ SAFETY CONDITIONS\r\n// =================================================================\r\n\r\nvar float lastTrackedLow  = na\r\nvar float lastZoneLow     = na\r\nvar float lastTrackedHigh = na\r\nvar float lastZoneHigh    = na\r\n\r\nif not na(trackedLow)\r\n    lastTrackedLow := trackedLow\r\nif not na(zone_Lower_line_price)\r\n    lastZoneLow := zone_Lower_line_price\r\nif not na(trackedHigh)\r\n    lastTrackedHigh := trackedHigh\r\nif not na(zone_Upper_line_price)\r\n    lastZoneHigh := zone_Upper_line_price\r\n\r\nvar float trackedLowZoneDiff  = na\r\nvar float trackedHighZoneDiff = na\r\n\r\nif not na(lastTrackedLow) and not na(lastZoneLow)\r\n    trackedLowZoneDiff  := math.abs(lastTrackedLow  - lastZoneLow)\r\nif not na(lastTrackedHigh) and not na(lastZoneHigh)\r\n    trackedHighZoneDiff := math.abs(lastTrackedHigh - lastZoneHigh)\r\n\r\ntrackedLowTooClose  = not na(trackedLowZoneDiff)  and trackedLowZoneDiff  < 20\r\ntrackedHighTooClose = not na(trackedHighZoneDiff) and trackedHighZoneDiff < 20\r\n\r\nvar bool llTooCloseShown = false\r\nvar bool hhTooCloseShown = false\r\nif (Bearish_Candle_exitingZone or Bullish_Candle_exitingZone) and inDateRange\r\n    llTooCloseShown := false\r\n    hhTooCloseShown := false\r\n\r\n\r\n// =================================================================\r\n// 📋 ENTRY CONDITIONS\r\n// =================================================================\r\n\r\nNot_on_Gren_line = (lineType != \"SUPPORT\") and (lineType != \"PD_L\")\r\nNot_on_Red_line  = (lineType != \"RESISTANCE\") and (lineType != \"PD_H\")\r\n\r\nclose_Above_Green_zone = not na(zone_Upper_line_price) and (close > zone_Upper_line_price)\r\nclose_Below_Red_zone   = not na(zone_Lower_line_price) and (close < zone_Lower_line_price)\r\n\r\ncandleSize    = high - low\r\n// maxCandleSize — input se aa raha hai (top mein declared)\r\n\r\nvar bool skipBigCandleZoneExit_Short = false\r\nif close_Below_Red_zone\r\n    if candleSize > maxCandleSize\r\n        skipBigCandleZoneExit_Short := true\r\n    else\r\n        skipBigCandleZoneExit_Short := false\r\n\r\nvar bool skipBigCandleZoneExit_Long = false\r\nif close_Above_Green_zone\r\n    if candleSize > maxCandleSize\r\n        skipBigCandleZoneExit_Long := true\r\n    else\r\n        skipBigCandleZoneExit_Long := false\r\n\r\n\r\n// =================================================================\r\n// CONDITIONS\r\n// =================================================================\r\n\r\nisGreenCandle = close > open\r\nisRedCandle   = close < open\r\n\r\nPrev_Green = Green_Zone and (close[1] > open[1])\r\nPrev_Red   = Red_Zone   and (close[1] < open[1])\r\n\r\nshortAboveTrackedLow = na(trackedLow) or close >= trackedLow\r\nlongBelowTrackedHigh = na(trackedHigh) or close <= trackedHigh\r\n\r\nIndex_Long_Signal = (\r\n         (useFreshZoneOnly ? greenZoneFresh : Green_Zone_Touch_and_Candle)\r\n     and Green_Zone\r\n     and Not_on_Red_line\r\n     and close_Above_Green_zone\r\n     and Prev_Green\r\n     and not skipBigCandleZoneExit_Long\r\n     and isGreenCandle\r\n     and longBelowTrackedHigh\r\n     )\r\n\r\nIndex_Short_Signal = (\r\n         (useFreshZoneOnly ? redZoneFresh : Red_Zone_Touch_and_Candle)\r\n     and Red_Zone\r\n     and Not_on_Gren_line\r\n     and close_Below_Red_zone\r\n     and Prev_Red\r\n     and not skipBigCandleZoneExit_Short\r\n     and isRedCandle\r\n     and shortAboveTrackedLow\r\n     )\r\n\r\n\r\n// =================================================================\r\n// 📊 ENTRY PLOTSHAPES + STRATEGY ORDERS\r\n// =================================================================\r\n\r\nvar int tradesToday = 0\r\nif ta.change(time(\"D\")) != 0\r\n    tradesToday := 0\r\n\r\nwhSymbol   = input.string(\"NIFTY\", \"Webhook symbol\", options=[\"NIFTY\",\"BANKNIFTY\"], group=\"🔗 Webhook\")\r\nwhStrategy = input.string(\"arschain_MAIN\", \"Webhook dashboard EXACT match)\", group=\"🔗 Webhook\")\r\n\r\n\r\nif Index_Long_Signal and inDateRange and tradesToday < maxTradesPerDay\r\n    strategy.entry(\"Long\", strategy.long)\r\n    tradesToday += 1\r\n    Green_Zone := false\r\n    Red_Zone   := false\r\n    log.info(\"SIGNAL LONG \" + str.format_time(time,\"yyyy-MM-dd HH:mm\",\"Asia/Kolkata\") + \" close=\" + str.tostring(close,\"#.##\") + \" line=\" + lineType)\r\n    alert('{\"id\":\"' + str.format_time(time,\"yyyyMMddHHmm\",\"Asia/Kolkata\") + '\",\"strategy\":\"' + whStrategy + '\",\"symbol\":\"' + whSymbol + '\",\"signal\":\"ENTRY\",\"action\":\"buy\"}', alert.freq_once_per_bar_close)\r\n\r\nif Index_Short_Signal and inDateRange and tradesToday < maxTradesPerDay\r\n    strategy.entry(\"Short\", strategy.short)\r\n    tradesToday += 1\r\n    Green_Zone := false\r\n    Red_Zone   := false\r\n    log.info(\"SIGNAL SHORT \" + str.format_time(time,\"yyyy-MM-dd HH:mm\",\"Asia/Kolkata\") + \" close=\" + str.tostring(close,\"#.##\") + \" line=\" + lineType)\r\n    alert('{\"id\":\"' + str.format_time(time,\"yyyyMMddHHmm\",\"Asia/Kolkata\") + '\",\"strategy\":\"' + whStrategy + '\",\"symbol\":\"' + whSymbol + '\",\"signal\":\"ENTRY\",\"action\":\"sell\"}', alert.freq_once_per_bar_close)\r\n\r\n\r\n// =================================================================\r\n// 🚪 EXIT SYSTEM\r\n// =================================================================\r\n\r\n// MainExit_Toggle, AtrExit_Toggle, SL_Blw_Fib_Exit_Tog — declared at top for group ordering\r\n\r\natrLen  = 14\r\natrMult = 2.0\r\natrVal  = ta.atr(atrLen)\r\n\r\nisNewLong  = strategy.position_size > 0 and strategy.position_size[1] == 0\r\nisNewShort = strategy.position_size < 0 and strategy.position_size[1] == 0\r\n\r\nvar float atrSL_Long  = na\r\nvar float atrSL_Short = na\r\n\r\nif isNewLong\r\n    atrSL_Long := strategy.position_avg_price - atrVal * atrMult\r\n\r\nif strategy.position_size > 0 and not na(atrSL_Long)\r\n    float newLongSL = close - atrVal * atrMult\r\n    if newLongSL > atrSL_Long\r\n        atrSL_Long := newLongSL\r\n\r\nif isNewShort\r\n    atrSL_Short := strategy.position_avg_price + atrVal * atrMult\r\n\r\nif strategy.position_size < 0 and not na(atrSL_Short)\r\n    float newShortSL = close + atrVal * atrMult\r\n    if newShortSL < atrSL_Short\r\n        atrSL_Short := newShortSL\r\n\r\nSL_Long_ATR  = strategy.position_size > 0 and not na(atrSL_Long)  and close < atrSL_Long\r\nSL_Short_ATR = strategy.position_size < 0 and not na(atrSL_Short) and close > atrSL_Short\r\n\r\nplot(AtrExit_Toggle and strategy.position_size > 0 ? atrSL_Long  : na,\r\n     title=\"ATR SL LONG\",  color=color.orange, linewidth=3, style=plot.style_stepline_diamond)\r\nplot(AtrExit_Toggle and strategy.position_size < 0 ? atrSL_Short : na,\r\n     title=\"ATR SL SHORT\", color=color.aqua,   linewidth=3, style=plot.style_stepline_diamond)\r\n\r\nclose_Above_Red_zone = not na(zone_Upper_line_price) and (close > zone_Upper_line_price)\r\n\r\nLong_indexExitCondition  = close_Below_Red_zone and (close < open)\r\n     and (useFreshZoneOnly ? redZoneFresh   : Red_Zone_Touch_and_Candle)\r\n\r\nShort_indexExitCondition = close_Above_Red_zone and (close > open)\r\n     and (useFreshZoneOnly ? greenZoneFresh : Green_Zone_Touch_and_Candle)\r\n\r\nvar bool  exitSignal = false\r\nvar string exitReason = \"\"\r\nvar string exitSide   = \"\"\r\n\r\nexitSignal := false\r\nexitSide   := \"\"\r\nexitReason := \"\"\r\n\r\nif strategy.position_size > 0 and barstate.isconfirmed\r\n\r\n    if AtrExit_Toggle and SL_Long_ATR\r\n        exitSignal := true\r\n        exitReason := \"ATR_LONG\"\r\n\r\n    else if MainExit_Toggle and Long_indexExitCondition and inDateRange\r\n        exitSignal := true\r\n        exitReason := \"ZONE_LONG\"\r\n\r\n    if exitSignal\r\n        strategy.close(\"Long\", comment=exitReason)\r\n        log.info(\"EXIT LONG \" + str.format_time(time,\"yyyy-MM-dd HH:mm\",\"Asia/Kolkata\") + \" reason=\" + exitReason + \" close=\" + str.tostring(close,\"#.##\"))\r\n        alert('{\"id\":\"' + str.format_time(time,\"yyyyMMddHHmm\",\"Asia/Kolkata\") + '\",\"strategy\":\"' + whStrategy + '\",\"symbol\":\"' + whSymbol + '\",\"signal\":\"EXIT\"}', alert.freq_once_per_bar_close)\r\n        exitSide := \"LONG\"\r\n        atrSL_Long := na\r\n\r\nif strategy.position_size < 0 and barstate.isconfirmed\r\n\r\n    if AtrExit_Toggle and SL_Short_ATR\r\n        exitSignal := true\r\n        exitReason := \"ATR_SHORT\"\r\n\r\n    else if MainExit_Toggle and Short_indexExitCondition and inDateRange\r\n        exitSignal := true\r\n        exitReason := \"ZONE_SHORT\"\r\n\r\n    if exitSignal\r\n        strategy.close(\"Short\", comment=exitReason)\r\n        log.info(\"EXIT SHORT \" + str.format_time(time,\"yyyy-MM-dd HH:mm\",\"Asia/Kolkata\") + \" reason=\" + exitReason + \" close=\" + str.tostring(close,\"#.##\"))\r\n        alert('{\"id\":\"' + str.format_time(time,\"yyyyMMddHHmm\",\"Asia/Kolkata\") + '\",\"strategy\":\"' + whStrategy + '\",\"symbol\":\"' + whSymbol + '\",\"signal\":\"EXIT\"}', alert.freq_once_per_bar_close)\r\n        exitSide := \"SHORT\"\r\n        atrSL_Short := na\r\n\r\n\r\n// =================================================================\r\n// ⏰ EXIT AT 3:15 PM\r\n// =================================================================\r\n\r\nexitHour          = 15\r\nexitMinute        = 15\r\nexitTimeCondition = (hour == exitHour and minute >= exitMinute)\r\n\r\nif exitTimeCondition\r\n    if strategy.position_size != 0\r\n        alert('{\"id\":\"' + str.format_time(time,\"yyyyMMddHHmm\",\"Asia/Kolkata\") + '\",\"strategy\":\"' + whStrategy + '\",\"symbol\":\"' + whSymbol + '\",\"signal\":\"EXIT\"}', alert.freq_once_per_bar_close)\r\n    strategy.close_all(comment=\"3:15 Daily Exit\")\r\n\r\n\r\n// =================================================================\r\n// 🔔 ALERTS\r\n// =================================================================\r\n\r\nalertcondition(Index_Long_Signal  and inDateRange, title=\"LONG Entry\",  message=\"🟢 LONG ENTRY @ {{ticker}} | Level: {{close}}\")\r\nalertcondition(Index_Short_Signal and inDateRange, title=\"SHORT Entry\", message=\"🔴 SHORT ENTRY @ {{ticker}} | Level: {{close}}\")\r\n\r\nalertcondition(exitSignal and exitSide == \"LONG\"  and inDateRange, title=\"EXIT Long\",  message=\"🚪 EXIT LONG @ {{ticker}} | {{close}}\")\r\nalertcondition(exitSignal and exitSide == \"SHORT\" and inDateRange, title=\"EXIT Short\", message=\"🚪 EXIT SHORT @ {{ticker}} | {{close}}\")\r\n\r\nalertcondition(exitTimeCondition, title=\"3:15 PM Exit\", message=\"⏰ 3:15 PM — Close all trades @ {{ticker}}\")",
  "line_count": 1356,
  "char_count": 51657
}